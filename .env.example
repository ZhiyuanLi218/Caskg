# Shared OpenAI-compatible endpoint used by graph construction and ALFWorld.
OPENAI_API_KEY=
OPENAI_BASE_URL=
API_KEY=
BASE_URL=

# Optional provider-specific credentials.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# CaSKG graph construction and retrieval.
CASKG_LLM_MODEL=openai/MiniMax-M2.7
CASKG_EMBEDDING_MODEL=openai/Qwen3-Embedding-8B
CASKG_EMBEDDING_DIM=4096
CASKG_WORKING_DIR=./data/caskg_workspace/skills_1000
CASKG_PREBUILT_WORKING_DIR=
CASKG_ENABLE_QUERY_REWRITE=false

# Controlled benchmark runners. These may point to the same endpoint above.
ROUTER_MASTER_KEY=
CASKG_ROUTER_BASE=
SCIENCEWORLD_ROUTER_BASE_URL=
CASKG_EXPECTED_CHAT_PROVIDER=
CASKG_ROUTER_SESSION_ID=anonymous-reproduction

# Benchmark installations.
ALFWORLD_DATA=
JAVA_HOME=
